REM ============================================================
REM GENERATION
REM ============================================================

set /a FOLDERS=0
set /a FILES=0

echo Starting generation...
echo.

for /L %%A in (1,1,20) do (

    set "A=0%%A"
    set "A=!A:~-2!"

    call set "CATEGORY=%%C!A!%%"

    echo ============================================================
    echo CATEGORY !A! - !CATEGORY!
    echo ============================================================

    set "CATEGORY_PATH=%ROOT%\!A!-!CATEGORY!"

    if not exist "!CATEGORY_PATH!" mkdir "!CATEGORY_PATH!"

    for /L %%B in (1,1,50) do (

        set "B=0%%B"
        set "B=!B:~-2!"

        call set "SUBCATEGORY=%%C!A!S!B!%%"

        set "SUB_PATH=!CATEGORY_PATH!\!B!-!SUBCATEGORY!"

        if not exist "!SUB_PATH!" mkdir "!SUB_PATH!"

        for /L %%D in (1,1,30) do (

            set "D=0%%D"
            set "D=!D:~-2!"

            call set "TYPE=%%T!D!%%"

            set "FINAL=!SUB_PATH!\!D!-!TYPE!"

            if not exist "!FINAL!" mkdir "!FINAL!"

            REM ---------------- HTML ----------------

            >"!FINAL!\!D!-!TYPE!.html" echo ^<!DOCTYPE html^>^<html lang="en"^>^<head^>^<meta charset="UTF-8"^>^<meta name="viewport" content="width=device-width,initial-scale=1.0"^>^<title^>!TYPE!^</title^>^<link rel="stylesheet" href="!D!-!TYPE!.css"^>^</head^>^<body^>^<main^>^<h1^>!TYPE!^</h1^>^</main^>^<script src="!D!-!TYPE!.js"^>^</script^>^</body^>^</html^>

            REM ---------------- CSS ----------------

            >"!FINAL!\!D!-!TYPE!.css" (
                echo * {
                echo     box-sizing: border-box;
                echo }
                echo.
                echo html {
                echo     scroll-behavior: smooth;
                echo }
                echo.
                echo body {
                echo     margin: 0;
                echo     min-height: 100vh;
                echo     font-family: Arial, sans-serif;
                echo     background: #ffffff;
                echo     color: #111827;
                echo }
            )

            REM ---------------- JS ----------------

            >"!FINAL!\!D!-!TYPE!.js" (
                echo "use strict";
                echo.
                echo document.addEventListener("DOMContentLoaded", function () {
                echo     console.log("!TYPE! loaded");
                echo });
            )

            REM ---------------- MD ----------------

            >"!FINAL!\!D!-!TYPE!.md" (
                echo # !TYPE!
                echo.
                echo ## Category
                echo !CATEGORY!
                echo.
                echo ## Subcategory
                echo !SUBCATEGORY!
                echo.
                echo ## Description
                echo.
                echo Documentation and development notes for !TYPE!.
                echo.
                echo ## HTML
                echo.
                echo Add HTML structure and semantic markup here.
                echo.
                echo ## CSS
                echo.
                echo Add responsive styling here.
                echo.
                echo ## JavaScript
                echo.
                echo Add interactive functionality here.
            )

            set /a FOLDERS+=1
            set /a FILES+=4
        )

        echo     !B!-!SUBCATEGORY! completed
    )

    echo.
)

echo.
echo ============================================================
echo                    COMPLETE
echo ============================================================
echo.
echo Master Folder:
echo %ROOT%
echo.
echo Main Categories : 20
echo Subcategories   : 1000
echo Final Folders   : !FOLDERS!
echo Files Created   : !FILES!
echo.
echo Expected Final Folders : 30000
