@echo off
setlocal EnableExtensions EnableDelayedExpansion

title Create Any Website in the World

REM ============================================================
REM MASTER FOLDER
REM ============================================================

set "ROOT=%~dp0Create Any Website in the World"

echo.
echo ============================================================
echo       CREATE ANY WEBSITE IN THE WORLD
echo ============================================================
echo.
echo Master folder:
echo %ROOT%
echo.
echo Structure:
echo.
echo 20 Main Categories
echo 50 Subcategories per Category
echo 30 Website Types per Subcategory
echo 4 Files per Website Type
echo.
echo Total:
echo 20 x 50 x 30 = 30,000 final folders
echo 30,000 x 4   = 120,000 files
echo.
echo ============================================================
echo.

if not exist "%ROOT%" mkdir "%ROOT%"

if not exist "%ROOT%" (
    echo ERROR: Could not create master folder.
    pause
    exit /b 1
)

